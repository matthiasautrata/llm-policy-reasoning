#include "rules.dl"
.decl s1(pass:number, total:number) .output s1
s1(1,T) :- cap_pass("r4"), cap_total("r4",T).
s1(0,T) :- cap_fail("r4"), cap_total("r4",T).
.decl s2(b:number) .output s2
s2(1) :- exempt("r4").
s2(0) :- !exempt("r4").
.decl s3(t:number) .output s3
s3(T) :- dept("cy",D), dept_total(D,T).
.decl s4(b:number) .output s4
s4(1) :- qualified_approver("r2","bo").
s4(0) :- !qualified_approver("r2","bo").
.decl s5(b:number) .output s5
s5(1) :- conflict("r5").
.decl s6(e:symbol) .output s6
s6(E) :- emp(E,_,_,_,L), L > 40000.
