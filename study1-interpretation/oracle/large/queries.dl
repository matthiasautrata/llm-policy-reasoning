// Oracle for the large world (phase B): rules.dl + facts.dl are the Datalog arm
// (p16) in Soufflé syntax. One output relation per scenario S1-S8.
#include "rules.dl"
#include "facts.dl"
.decl s1(c:symbol)  .output s1
s1(C) :- over_committed(C).
.decl s2(h:number)  .output s2
s2(H) :- headroom("eng",H).
.decl s3(b:number)  .output s3
s3(1) :- vendor_ok("r10").
s3(0) :- !vendor_ok("r10").
.decl s4(b:number)  .output s4
s4(1) :- escalation("r14").
s4(0) :- !escalation("r14").
.decl s5(n:number)  .output s5
s5(N) :- emp(E,"An Corp_Legal1",_,_), dept(E,D), dept_headcount(D,N).
.decl s6(a:number)  .output s6
s6(A) :- emp(E,"An Corp_Legal1",_,_), dept(E,D), dept_exposure(D,A).
.decl s7(deny:number, auto:number, conflict:number)  .output s7
s7(1,1,1) :- conflict("r37").
.decl s8(n:number)  .output s8
s8(N) :- N = count : { chain(_,"e000") }.
// p15 control: vendor check evaluated at today's date instead of the request date
.decl bolt_ok_today()
bolt_ok_today() :- today(D), vendor_period("bolt","approved",F,T), F <= D, D <= T.
.decl s3_today(b:number)  .output s3_today
s3_today(1) :- bolt_ok_today().
s3_today(0) :- !bolt_ok_today().
