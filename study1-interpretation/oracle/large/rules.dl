// --- Relations ---
.decl cc(c:symbol)
.decl cc_parent(x:symbol, y:symbol)
.decl org_unit(u:symbol, o:symbol)
.decl emp(e:symbol, name:symbol, role:symbol, c:symbol)
.decl reports(e:symbol, m:symbol)
.decl role_limit_period(role:symbol, l:number, f:number, t:number)
.decl req(r:symbol, e:symbol, a:number, kind:symbol, v:symbol, d:number, st:symbol)
.decl vendor_period(v:symbol, s:symbol, f:number, t:number)
.decl booked(c:symbol, q:symbol, b:number)
.decl cap(c:symbol, q:symbol, k:number)
.decl violation(e:symbol)
.decl today(d:number)
.decl exemption_withdrawn(w:number)

// --- Derived ---
.decl emp_cc(e:symbol, c:symbol)
.decl req_cc(r:symbol, c:symbol)
.decl cc_anc(x:symbol, y:symbol)
.decl charges(r:symbol, c:symbol)
.decl spend_item(c:symbol, lbl:symbol, b:number)
.decl booked_at(c:symbol, t:number)
.decl committed(c:symbol, t:number)
.decl headroom(c:symbol, h:number)
.decl over_committed(c:symbol)
.decl cap_total(r:symbol, c:symbol, t:number)
.decl cap_breach(r:symbol, c:symbol)
.decl cap_ok(r:symbol)
.decl cap_breach_any(r:symbol)
.decl req_date(r:symbol, d:number)
.decl eff_date(r:symbol, d:number)
.decl vendor_ok(r:symbol)
.decl limit_at(e:symbol, l:number, d:number)
.decl exempt(r:symbol)
.decl chain(e:symbol, m:symbol)
.decl approver(r:symbol, e:symbol)
.decl has_approver(r:symbol)
.decl dept(e:symbol, c:symbol)
.decl dept_headcount(c:symbol, n:number)
.decl dept_exposure(c:symbol, a:number)
.decl dept_approver(r:symbol, e:symbol)
.decl escalation(r:symbol)
.decl dept_approver_any(r:symbol)
.decl deny(r:symbol)
.decl auto_approve(r:symbol)
.decl conflict(r:symbol)

// --- Rules ---
emp_cc(E,C) :- emp(E,_,_,C).
req_cc(R,C) :- req(R,E,_,_,_,_,_), emp_cc(E,C).
cc_anc(X,Y) :- cc_parent(X,Y).
cc_anc(X,Z) :- cc_parent(X,Y), cc_anc(Y,Z).
charges(R,C) :- req_cc(R,C).
charges(R,A) :- req_cc(R,C), cc_anc(C,A).
spend_item(C,"zero",0) :- cc(C).
spend_item(C,"booked",B) :- booked(C,"2026Q3",B).
spend_item(P,C,B) :- booked(C,"2026Q3",B), cc_anc(C,P).
booked_at(C,S) :- spend_item(C,_,_), S = sum B : { spend_item(C,_,B) }.
committed(C,T) :- booked_at(C,T).
headroom(C,H) :- committed(C,T), cap(C,"2026Q3",K), H = K - T.
over_committed(C) :- committed(C,T), cap(C,"2026Q3",K), T > K.
cap_total(R,C,T) :- charges(R,C), req(R,_,A,_,_,_,_), committed(C,B), T = B + A.
cap_breach(R,C) :- cap_total(R,C,T), cap(C,"2026Q3",K), T > K.
cap_ok(R) :- req(R,_,_,_,_,_,_), !cap_breach_any(R).
cap_breach_any(R) :- cap_breach(R,_).
req_date(R,D) :- req(R,_,_,_,_,D,_).
eff_date(R,D) :- req_date(R,D).
vendor_ok(R) :- req(R,_,_,_,V,_,_), eff_date(R,D), vendor_period(V,"approved",F,T), F <= D, D <= T.
limit_at(E,L,D) :- emp(E,_,Role,_), role_limit_period(Role,L,F,T), eff_date(_,D), F <= D, D <= T.
exempt(R) :- req(R,_,_,"capital",_,_,_), eff_date(R,D), exemption_withdrawn(W), D < W.
chain(E,M) :- reports(E,M).
chain(E,M) :- reports(E,X), chain(X,M).
approver(R,E) :- req(R,Q,A,_,_,_,_), chain(Q,E), eff_date(R,D), limit_at(E,L,D), L >= A.
has_approver(R) :- approver(R,_).
dept(E,C2) :- emp(E,_,_,C2).
dept_headcount(C,N) :- dept(_,C), N = count : { dept(_,C) }.
dept_exposure(C,S) :- dept(_,C), S = sum A : { req(Rr,Ee,A,_,_,_,"pending"), dept(Ee,C) }.
dept_approver(R,E) :- approver(R,E), req(R,Q,_,_,_,_,_), dept(Q,D2), dept(E,D2).
escalation(R) :- has_approver(R), !dept_approver_any(R).
dept_approver_any(R) :- dept_approver(R,_).
deny(R) :- req(R,E,_,_,_,_,_), violation(E).
auto_approve(R) :- req(R,_,A,"software",_,_,_), A < 10000.
conflict(R) :- deny(R), auto_approve(R).

