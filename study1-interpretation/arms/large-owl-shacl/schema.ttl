@prefix ex:   <http://example.org/proc#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/proc> a owl:Ontology .

# ---------- classes ----------
ex:CostCentre         a owl:Class .
ex:BudgetLine         a owl:Class .
ex:Employee           a owl:Class .
ex:Role               a owl:Class .
ex:RoleLimitPeriod    a owl:Class .
ex:Vendor             a owl:Class .
ex:VendorStatusPeriod a owl:Class .
ex:PurchaseRequest    a owl:Class .
ex:PolicyContext      a owl:Class .
ex:AllDisjoint a owl:AllDisjointClasses ; owl:members ( ex:CostCentre ex:BudgetLine ex:Employee ex:Role
    ex:RoleLimitPeriod ex:Vendor ex:VendorStatusPeriod ex:PurchaseRequest ex:PolicyContext ) .

# ---------- asserted properties ----------
ex:parentCostCentre a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range ex:CostCentre .
ex:orgUnit          a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:string .
ex:costCentre       a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:range ex:CostCentre .   # of BudgetLine or Employee
ex:quarter          a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:BudgetLine ; rdfs:range xsd:string .
ex:booked           a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:BudgetLine ; rdfs:range xsd:integer .
ex:cap              a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:BudgetLine ; rdfs:range xsd:integer .
ex:name             a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:Employee ; rdfs:range xsd:string .
ex:role             a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:Employee ; rdfs:range ex:Role .
ex:reportsTo        a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:Employee ; rdfs:range ex:Employee .
ex:hasPolicyViolation a owl:DatatypeProperty ; rdfs:domain ex:Employee ; rdfs:range xsd:boolean .
ex:forRole          a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:RoleLimitPeriod ; rdfs:range ex:Role .
ex:limit            a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:RoleLimitPeriod ; rdfs:range xsd:integer .
ex:forVendor        a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:VendorStatusPeriod ; rdfs:range ex:Vendor .
ex:vendorStatus     a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:VendorStatusPeriod ; rdfs:range xsd:string .
ex:validFrom        a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:date .
ex:validTo          a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:date .
ex:requester        a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range ex:Employee .
ex:amount           a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:integer .
ex:category         a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:string .
ex:vendor           a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range ex:Vendor .
ex:requestDate      a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:date .
ex:status           a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:string .
ex:today            a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PolicyContext ; rdfs:range xsd:date .
ex:exemptionWithdrawnOn a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:PolicyContext ; rdfs:range xsd:date .

# ---------- derived properties (populated by the SHACL rules in rules.ttl) ----------
ex:ancestorCostCentre a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain ex:CostCentre ; rdfs:range ex:CostCentre .
ex:parentCostCentre rdfs:subPropertyOf ex:ancestorCostCentre .
ex:inReportingChainOf a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:domain ex:Employee ; rdfs:range ex:Employee .
ex:reportsTo rdfs:subPropertyOf ex:inReportingChainOf .
ex:bookedSpend      a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:integer .
ex:headroom         a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:integer .
ex:overCommitted    a owl:DatatypeProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:boolean .
ex:charges          a owl:ObjectProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range ex:CostCentre .
ex:breachesCapOf    a owl:ObjectProperty ; rdfs:subPropertyOf ex:charges .
ex:vendorCheckPassed a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
ex:eligibleApprover a owl:ObjectProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range ex:Employee .
ex:department       a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:domain ex:Employee ; rdfs:range ex:CostCentre .
ex:headcount        a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:integer .
ex:pendingExposure  a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain ex:CostCentre ; rdfs:range xsd:integer .
ex:requiresEscalation a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
ex:denied           a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
ex:autoApproved     a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
ex:inConflict       a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
ex:exempt           a owl:DatatypeProperty ; rdfs:domain ex:PurchaseRequest ; rdfs:range xsd:boolean .
