// Scaling-test policy. Lines tagged //L2 are active only at override level 2.
.decl cc(c:symbol)
.decl cc_parent(c:symbol, p:symbol)
.decl emp(e:symbol, role:symbol, c:symbol)
.decl reports(e:symbol, m:symbol)
.decl role_limit(role:symbol, l:number)
.decl vendor(v:symbol, status:symbol)
.decl req(r:symbol, e:symbol, a:number, category:symbol, v:symbol)
.decl booked(c:symbol, b:number)
.decl cap(c:symbol, k:number)
.decl violation(e:symbol)            //L2
.decl emergency(r:symbol)            //L2

.decl cc_anc(c:symbol, a:symbol)
.decl chain(e:symbol, m:symbol)
.decl spend_item(c:symbol, src:symbol, b:number)
.decl booked_total(c:symbol, t:number)
.decl headroom(c:symbol, h:number)
.decl over_cap(c:symbol)
.decl charges(r:symbol, c:symbol)
.decl cap_breach(r:symbol)
.decl has_approver(r:symbol)
.decl big_capital(r:symbol)             //L2
.decl vendor_ok(r:symbol)
.decl eligible(r:symbol)
.decl denied(r:symbol)
.decl approved(r:symbol)

cc_anc(C,P) :- cc_parent(C,P).
cc_anc(C,A) :- cc_parent(C,P), cc_anc(P,A).
chain(E,M) :- reports(E,M).
chain(E,M) :- reports(E,X), chain(X,M).
spend_item(C,C,B) :- booked(C,B).
spend_item(A,C,B) :- booked(C,B), cc_anc(C,A).
booked_total(C,T) :- cc(C), T = sum B : { spend_item(C,_,B) }.
headroom(C,H) :- booked_total(C,T), cap(C,K), H = K - T.
over_cap(C) :- booked_total(C,T), cap(C,K), T > K.
charges(R,C) :- req(R,E,_,_,_), emp(E,_,C).
charges(R,A) :- req(R,E,_,_,_), emp(E,_,C), cc_anc(C,A).
cap_breach(R) :- charges(R,C), req(R,_,A,_,_), booked_total(C,T), cap(C,K), T + A > K.
has_approver(R) :- req(R,Q,A,_,_), chain(Q,M), emp(M,Role,_), role_limit(Role,L), L >= A.
big_capital(R) :- req(R,_,A,"capital",_), A > 50000.                                  //L2
vendor_ok(R) :- req(R,_,_,_,V), vendor(V,"approved").
vendor_ok(R) :- req(R,_,_,_,V), vendor(V,"suspended"), emergency(R), !big_capital(R).   //L2
eligible(R) :- has_approver(R), !cap_breach(R), vendor_ok(R).
denied(R) :- req(R,E,_,_,_), violation(E).                                              //L2
approved(R) :- eligible(R), !denied(R).
