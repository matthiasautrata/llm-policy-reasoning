@prefix ex:   <http://example.org/proc#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------- rules (SHACL-AF). sh:order stratifies: a rule reads only properties derived at a lower order ----------
ex:prefixes a owl:Ontology ; sh:declare [ sh:prefix "ex" ; sh:namespace "http://example.org/proc#"^^xsd:anyURI ] .
ex:CostCentreRules a sh:NodeShape ; sh:targetClass ex:CostCentre ;
  sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:ancestor ?a } WHERE { $this ex:parent+ ?a }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:bookedTotal ?t } WHERE { { SELECT $this (SUM(?b) AS ?t) WHERE {
      ?d ex:parent* $this . OPTIONAL { ?d ex:booked ?b0 } BIND(COALESCE(?b0, 0) AS ?b) } GROUP BY $this } }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:headroom ?h } WHERE { $this ex:bookedTotal ?t ; ex:cap ?k . BIND(?k - ?t AS ?h) }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:overCap true } WHERE { $this ex:bookedTotal ?t ; ex:cap ?k . FILTER(?t > ?k) }""" ] .
ex:EmployeeRules a sh:NodeShape ; sh:targetClass ex:Employee ;
  sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:inChainOf ?m } WHERE { $this ex:reportsTo+ ?m }""" ] .
ex:RequestRules a sh:NodeShape ; sh:targetClass ex:Request ;
  sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:vendorOk true } WHERE { $this ex:vendor/ex:status "approved" }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:charges ?c } WHERE { $this ex:requester/ex:costCentre/ex:parent* ?c }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:hasApprover true } WHERE { $this ex:requester/ex:inChainOf ?m ; ex:amount ?a .
      ?m ex:role/ex:limit ?l . FILTER(?l >= ?a) }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:capBreach true } WHERE { $this ex:charges ?c ; ex:amount ?a .
      ?c ex:bookedTotal ?t ; ex:cap ?k . FILTER(?t + ?a > ?k) }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:eligible true } WHERE { $this ex:hasApprover true ; ex:vendorOk true .
      FILTER NOT EXISTS { $this ex:capBreach true } }""" ] ;
  sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes ex:prefixes ;
    sh:construct """CONSTRUCT { $this ex:approved true } WHERE { $this ex:eligible true . FILTER NOT EXISTS { $this ex:denied true } }""" ] .
