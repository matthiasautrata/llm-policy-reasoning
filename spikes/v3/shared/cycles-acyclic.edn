;; Acyclic dispute fixtures (PLAN-v3-integrity §3.1), loaded on top of slice.edn + extension.edn in the
;; normal run (accept.py check 7). Built from cycles.edn: Y1 and Y4 unchanged, the Y2 control without the
;; loop-closing defeater RY24, and the Y5 variants on Y1's dispute (fern blacklisted, contested).
;; The cyclic parts (Y2 even loop, Y3 odd loop) are load-rejection fixtures in fixtures/integrity/.
;; Questions :state :acyclic in questions.edn, keys under keys.json "acyclic". No predicate here occurs
;; in slice.edn or extension.edn except the ones RY56 reads (cost_centre_of, the booked_total measure).
[
 ;; Y1: two claims rebut each other directly; equal authority, no superiority -> CONFLICT.
 {:id :CY1a :about "vendor:fern" :assertion [:blacklisted "fern"]
  :asserted_by :risk :asserted_at #inst "2026-09-01" :valid_from #inst "2026-09-01" :valid_to nil
  :recorded_at #inst "2026-09-15"
  :backing "Risk watch W-41: adverse media" :qualifier "presumably"}
 {:id :CY1b :about "vendor:fern" :assertion [:neg [:blacklisted "fern"]]
  :asserted_by :compliance :asserted_at #inst "2026-09-02" :valid_from #inst "2026-09-02" :valid_to nil
  :recorded_at #inst "2026-09-15"
  :backing "Compliance review CR-9: media report unfounded" :qualifier "presumably"}

 ;; Y2 control, acyclic: RY23 attacks preferred, nothing attacks under_review (RY24 is the loop; Y6
 ;; adds it inside a hypothesis, which must be rejected with defeat-cycle).
 {:id :RY21 :kind :defeasible :owner :procurement :class :material_inference
  :recorded_at #inst "2026-09-15"
  :doc "A vendor approved in the register on the evaluation date is preferred."
  :head [:preferred ?v]
  :body [[:as_of ?d] [:fetch :vendor_status {:vendor ?v :status "approved"} {:valid_from ?f :valid_to ?t}] [:<= ?f ?d] [:<= ?d ?t]]}
 {:id :RY22 :kind :defeasible :owner :compliance :class :material_inference
  :recorded_at #inst "2026-09-15"
  :doc "A vendor with a suspension on record in the register is under review."
  :head [:under_review ?v]
  :body [[:fetch :vendor_status {:vendor ?v :status "suspended"} {}]]}
 {:id :RY23 :kind :defeater :owner :compliance :class :exception
  :recorded_at #inst "2026-09-15"
  :doc "A vendor under review is not preferred."
  :head [:neg [:preferred ?v]]
  :body [[:under_review ?v]]}

 ;; Y4: Y1's shape, broken by an authority superiority rule -> ANSWER for the superior side.
 {:id :CY4a :about "vendor:cog" :assertion [:watchlisted "cog"]
  :asserted_by :risk :asserted_at #inst "2026-09-01" :valid_from #inst "2026-09-01" :valid_to nil
  :recorded_at #inst "2026-09-15"
  :backing "Risk watch W-42" :qualifier "presumably"}
 {:id :CY4b :about "vendor:cog" :assertion [:neg [:watchlisted "cog"]]
  :asserted_by :compliance :asserted_at #inst "2026-09-02" :valid_from #inst "2026-09-02" :valid_to nil
  :recorded_at #inst "2026-09-15"
  :backing "Compliance review CR-10" :qualifier "presumably"}
 {:id :RY4 :kind :superiority :owner :controller :class :superiority
  :recorded_at #inst "2026-09-15"
  :doc "Where risk and compliance disagree on a watchlist entry, risk prevails."
  :pred :watchlisted :order [:risk :compliance]}

 ;; Y5 on Y1's dispute. Y5a: a supporter's body is the contested literal.
 {:id :RY51 :kind :defeasible :owner :procurement :class :material_inference
  :recorded_at #inst "2026-09-15"
  :doc "A blacklisted vendor is flagged."
  :head [:flagged ?v]
  :body [[:blacklisted ?v]]}

 ;; Y5c: an attacker's body is the contested literal.
 {:id :CY5 :about "vendor:fern" :assertion [:onboarded "fern"]
  :asserted_by :procurement :asserted_at #inst "2026-02-01" :valid_from #inst "2026-02-01" :valid_to nil
  :recorded_at #inst "2026-09-15"
  :backing "Vendor onboarding file VO-30" :qualifier "certainly"}
 {:id :RY53 :kind :defeasible :owner :procurement :class :material_inference
  :recorded_at #inst "2026-09-15"
  :doc "An onboarded vendor is cleared for tender."
  :head [:cleared_for_tender ?v]
  :body [[:onboarded ?v]]}
 {:id :RY54 :kind :defeater :owner :risk :class :exception
  :recorded_at #inst "2026-09-15"
  :doc "A blacklisted vendor is not cleared for tender."
  :head [:neg [:cleared_for_tender ?v]]
  :body [[:blacklisted ?v]]}

 ;; Y5d: [:not ..] of the contested literal (closed over the known facts: qualified).
 {:id :RY55 :kind :defeasible :owner :procurement :class :material_inference
  :recorded_at #inst "2026-09-15" :closed_over :known_facts
  :doc "A vendor that is not blacklisted passes screening."
  :head [:screening_clear ?v]
  :body [[:not [:blacklisted ?v]]]}

 ;; Y5e: a measure fetched over a contested binding (the rule language aggregates table rows only, so a
 ;; measure over a set of derived literals is not expressible; see Decisions 2026-11-25 phase 2).
 {:id :RY56 :kind :defeasible :owner :finance :class :material_inference
  :recorded_at #inst "2026-09-15" :completeness [:C10]
  :doc "An employee's home budget is the booked total of the cost centre the employee is in."
  :head [:home_budget ?e ?v]
  :body [[:cost_centre_of ?e ?c] [:fetch :booked_total {:cc ?c} {:value ?v}]]}]
