;; Calling modes per derived predicate (model_check.py, PLAN-v3-cycles §1.4): + the caller must bind the
;; position, - may be free. Several modes = any one of them suffices. model_check.py infers modes from the
;; rule bodies (left-to-right binding) and rejects any difference from these declarations, any call site
;; that binds less, and any question goal that binds less. Claims-only predicates (fit_for_use,
;; cost_centre_of, blacklisted, ...) are facts and need no declaration.
{;; slice.edn
 :booked_total "+-" :headroom "+-" :cap_breach "+" :breach_in "+-" :big_capital "+"
 :role_limit "+-"
 :limit_on "++-"          ; R202: role and date bound; the date is compared, not enumerated
 :governing_limit "++-" :vendor_status_for "+-"
 :has_approver "+"
 :cap_ok "+"              ; R304: [:not [:cap_breach ?r]] needs ?r bound
 :vendor_cleared "+" :eligible "+" :denied "+" :approved "+" :auto_approved "+"
 :approved_total "+-" :approved_count "+-"   ; R120 / R121: [:agg ..] over the subtree
 :home_headroom "--" :po_issued "+"          ; R315 (cost_centre_of is claims-only) / R316, preconditions §2.3
 ;; the dispute and loop fixtures (cycles-acyclic.edn, fixtures/integrity)
 :preferred "+" :under_review "+" :approved_supplier "+"
 :trusted "-" :exempt_from_audit "-"   ; CY3 is a claim: enumerable
 :flagged "-" :cleared_for_tender "-"
 ;; cycles-acyclic.edn only (PLAN-v3-integrity §3.1)
 :screening_clear "+"     ; RY55: [:not [:blacklisted ?v]] needs ?v bound
 :home_budget "--"        ; RY56: cost_centre_of is claims-only (enumerable)
 ;; fixtures/integrity (declared so each fixture fails on its own violation only)
 :board_signoff "+"
 :chain_booked "+-"       ; IR-007 fixture RA1
 ;; bench/gen.py families (PLAN-v3-bench §2): instance code free, the entity bound
 :programme_limit_ok "-+" :programme_cleared "-+" :capitalised "-+" :perk "-+" :centre_tag "-+"
 ;; P01's sub-programme chain (PLAN-v3-bench-full §3b'), one predicate per level: the gate's cycle check is per predicate
 :u01_cleared "+" :u02_cleared "+" :u03_cleared "+" :u04_cleared "+" :u05_cleared "+" :u06_cleared "+"}
